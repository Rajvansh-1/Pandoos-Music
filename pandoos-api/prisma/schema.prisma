generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Users ──────────────────────────────────────────────────────────
model User {
  id                 String    @id @default(uuid()) // Supabase UUID
  email              String    @unique
  username           String?   @unique
  avatarUrl          String?
  
  // Gamification State
  xp                 Int       @default(0)
  level              Int       @default(1)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  totalSongsPlayed   Int       @default(0)
  totalListeningTime Int       @default(0) // in seconds
  sessionStart       DateTime? 

  // Relationships
  badges             UserBadge[]
  genresExplored     UserGenre[]
  playlists          Playlist[]
  listeningHistory   ListeningHistory[]
  likedSongs         LikedSong[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─── Gamification ───────────────────────────────────────────────────
model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String   // Corresponds to BadgeId enum in frontend (e.g., 'night_owl')
  unlockedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId]) // A user can only unlock a badge once
}

model UserGenre {
  id        String   @id @default(uuid())
  userId    String
  genre     String   // Represents the 'Mood' enum from frontend

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, genre])
}

// ─── Music Data (Cached) ────────────────────────────────────────────
// Stores metadata of songs played to avoid hitting YouTube API repeatedly
model Song {
  id          String   @id // YouTube Video ID
  title       String
  artist      String
  coverUrl    String?
  duration    Int?     // in seconds

  // Relationships
  playlists   PlaylistSong[]
  history     ListeningHistory[]
  likedBy     LikedSong[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Playlists & Library ────────────────────────────────────────────
model Playlist {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs       PlaylistSong[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlaylistSong {
  id          String   @id @default(uuid())
  playlistId  String
  songId      String
  order       Int      @default(0)
  addedAt     DateTime @default(now())

  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

model LikedSong {
  id          String   @id @default(uuid())
  userId      String
  songId      String
  likedAt     DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}

// ─── Analytics ──────────────────────────────────────────────────────
model ListeningHistory {
  id          String   @id @default(uuid())
  userId      String
  songId      String
  mood        String?  // The mood at the time of listening
  playedAt    DateTime @default(now())
  completed   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
}
