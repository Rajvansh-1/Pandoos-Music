# Pandoos Music — Environment Variables
# Copy this file to .env and fill in your values

# ─── YouTube API Key (FREE) ───────────────────────────────
# Get yours at: https://console.cloud.google.com
# Steps:
#   1. Create project → Enable "YouTube Data API v3"
#   2. Credentials → Create API Key → Copy it here
#   3. Free quota: 10,000 units/day (~100 searches/day)
#
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
